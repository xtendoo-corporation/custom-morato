<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_product_search_inherit_morato" model="ir.ui.view">
        <field name="name">sale.report.search.inherit.morato</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_date']" position="after">
                <filter string="Hoy"
                        name="today"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"
                        help="Ventas del día de hoy"/>
            </xpath>
        </field>
    </record>
</odoo>
