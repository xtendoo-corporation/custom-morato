<odoo>
    <!-- Acción cliente para el ticket de factura -->
    <record id="action_invoice_ticket_client" model="ir.actions.client">
        <field name="name">Ticket de Factura</field>
        <field name="tag">invoice_ticket_pos</field>
        <field name="target">new</field>
    </record>

    <!-- Vista heredada para agregar botón de ticket en facturas -->
    <record id="view_move_form_mobile_ticket" model="ir.ui.view">
        <field name="name">account.move.form.mobile.ticket</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botón móvil después del header solo para facturas de cliente -->
            <xpath expr="//header" position="after">
                <div class="o_mobile_only" style="display: flex; gap: 8px; align-items: center; margin: 8px 0;"
                     invisible="move_type != 'out_invoice'">
                    <button name="%(action_invoice_ticket_client)d"
                            type="action"
                            class="btn btn-secondary"
                            context="{'invoice_id': id}"
                            invisible="state != 'posted'">
                        <i class="fa fa-print" title="Ver Ticket"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <xpath expr="//div[@name='currency_div']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>

        </field>
    </record>


</odoo>
