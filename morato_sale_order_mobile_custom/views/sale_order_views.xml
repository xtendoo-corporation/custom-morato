<odoo>
    <record id="action_sale_ticket_client" model="ir.actions.client">
        <field name="name">Ticket de Venta</field>
        <field name="tag">sale_ticket_pos</field>
        <field name="target">new</field>
    </record>

    <record id="view_order_form_mobile_hide_fields" model="ir.ui.view">
        <field name="name">sale.order.form.mobile.hide.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar campos en móvil para pedidos de venta -->

            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
<!--            <xpath expr="//label[@name='payment_term_id']" position="attributes">-->
<!--                <attribute name="class">o_mobile_hide</attribute>-->
<!--            </xpath>-->
            <!--            <xpath expr="//field[@name='pricelist_id']" position="attributes">-->
            <!--                <attribute name="class">o_mobile_hide</attribute>-->
            <!--            </xpath>-->
            <!--            <xpath expr="//field[@name='date_order']" position="attributes">-->
            <!--                <attribute name="class">o_mobile_hide</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="class">o_mobile_hide</attribute>
            </xpath>
            <!--            <xpath expr="//field[@name='delivery_zone_id']" position="attributes">-->
            <!--                <attribute name="class">o_mobile_hide</attribute>-->
            <!--            </xpath>-->

            <!-- Quitar el campo product_uom_qty de su posición original -->
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                position="replace"
            ></xpath>

            <!-- Añadir el campo product_uom_qty después de box_units -->
            <xpath expr="//field[@name='order_line']/list//field[@name='box_units']" position="after">
                <field name="product_uom_qty"/>
            </xpath>

            <!-- Botones móviles después del header -->
            <xpath expr="//header" position="before">
                <div class="o_mobile_only" style="display: flex; gap: 8px; align-items: center; margin: 8px 0;">
                    <button name="action_mobile_custom"
                            type="object"
                            string="Confirmar Pedido"
                            class="btn btn-primary"
                            invisible="state in ['sale', 'done', 'cancel']"
                    />
                    <button name="%(action_sale_ticket_client)d"
                            type="action"
                            class="btn btn-secondary"
                            context="{'order_id': id}"
                            invisible="state not in ['sale', 'done']">
                        <i class="fa fa-print" title="Ver Ticket"/>
                    </button>

                    <!-- Botón Ver Factura - solo si hay facturas -->
                    <button name="action_view_invoice"
                            type="object"
                            class="btn btn-info"
                            invisible="not invoice_ids">
                        <i class="fa fa-file-text" title="Ver Factura"/>
                    </button>

                </div>
            </xpath>
        </field>
    </record>
</odoo>
