<!-- views/sale_order_views.xml -->
<odoo>
    <record id="view_order_form_barcode_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.barcode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Agregar en las líneas de pedido -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="before">
<!--                <field name="barcode"-->
<!--                       placeholder="📱 Escanea código de barras..."-->
<!--                       class="o_barcode_field"-->
<!--                       attrs="{'invisible': [('product_id', '!=', False)]}"-->
<!--                       options="{'no_open': True}"/>-->
            </xpath>
        </field>
    </record>

    <!-- Vista específica para móvil -->
    <record id="view_order_form_mobile_barcode" model="ir.ui.view">
        <field name="name">sale.order.form.mobile.barcode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//form//label[@for='product_id']" position="before">
                <field name="barcode"
                       placeholder="📱 Escanea código de barras para encontrar el producto..."
                       class="o_barcode_field_mobile"
                       widget="char"
                        />
            </xpath>
        </field>
    </record>
</odoo>
