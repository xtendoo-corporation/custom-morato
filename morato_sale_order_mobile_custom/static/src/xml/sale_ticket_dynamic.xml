<odoo>
    <template t-name="morato_sale_order_mobile_custom.sale_order_ticket_template" owl="1">
        <div class="o_sale_ticket_container">
            <t t-if="state.docs">
                <t t-foreach="state.docs" t-as="o" t-key="o.id">
                    <div style="width: 58mm; font-family: monospace; font-size:12px; text-align: center; margin: 0 auto;">
                        <p style="text-align: center; margin: 3px 0;">*** TICKET DE VENTA ***</p>
                        <p style="text-align: center; margin: 3px 0;">Pedido:
                            <t t-esc="o.name"/>
                        </p>
                        <p style="text-align: center; margin: 3px 0;">Cliente:
                            <t t-esc="o.partner_id[1]"/>
                        </p> <!-- partner_id es array [id, name] -->
                        <p style="text-align: center; margin: 3px 0;">Fecha:
                            <t t-esc="o.date_order"/>
                        </p>
                        <t t-foreach="o.order_line" t-as="l" t-key="l.id">
                            <p style="text-align: left; margin: 2px 0;">
                                <t t-esc="l.product_id[1]"/>
                            </p>
                            <p style="text-align: left; margin: 2px 0;">
                                x<t t-esc="l.product_uom_qty"/>
                                <t t-esc="l.price_unit"/>€
                                = <t t-esc="l.price_subtotal"/>€
                            </p>
                        </t>
                        <hr style="margin: 8px auto; width: 80%;"/>
                        <p style="text-align: center; margin: 5px 0;">
                            <strong>Total:
                                <t t-esc="o.amount_total"/>
                                €
                            </strong>
                        </p>
                        <p style="text-align: center; margin: 5px 0;">Gracias por su compra</p>
                    </div>
                </t>

                <!-- Botón de impresión -->
                <div class="mt-3 text-center">
                    <button class="btn btn-primary" t-on-click="onPrint">
                        <i class="fa fa-print"></i> Imprimir Ticket
                    </button>
                </div>
            </t>
            <t t-if="!state.docs">
                <p style="text-align: center;">Cargando ticket...</p>
            </t>
        </div>
    </template>
</odoo>
