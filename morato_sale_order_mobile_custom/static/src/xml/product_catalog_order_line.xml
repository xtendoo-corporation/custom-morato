<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="product.ProductCatalogOrderLine" t-inherit="product.ProductCatalogOrderLine" t-inherit-mode="extension">
        <!-- Añadir inputs para cajas y unidades por caja al final del componente -->
        <xpath expr="//div[hasclass('d-flex', 'justify-content-end', 'align-items-center', 'm-2')]" position="before">
            <!-- Solo mostrar los inputs de cajas cuando el producto está en el pedido -->
            <div t-if="isInOrder()" class="m-2 pt-2 border-top">
                <div class="row g-2">
                    <!-- Input para Cajas -->
                    <div class="col-6">
                        <label class="form-label text-muted small mb-1">Cajas</label>
                        <div class="input-group input-group-sm">
                            <button class="btn btn-outline-secondary"
                                    t-on-click.stop="decreaseBoxes"
                                    type="button">
                                <i class="fa fa-minus"/>
                            </button>
                            <input class="form-control text-center"
                                   type="number"
                                   min="0"
                                   t-att-value="boxes || 0"
                                   t-on-change="setBoxes"
                                   placeholder="0"/>
                            <button class="btn btn-outline-secondary"
                                    t-on-click.stop="increaseBoxes"
                                    type="button">
                                <i class="fa fa-plus"/>
                            </button>
                        </div>
                    </div>
                    <!-- Input para Unidades por Caja -->
                    <div class="col-6">
                        <label class="form-label text-muted small mb-1">Uds/Caja</label>
                        <input class="form-control form-control-sm text-center"
                               type="number"
                               min="1"
                               t-att-value="unitsPerBox || 1"
                               t-on-change="setUnitsPerBox"
                               placeholder="1"/>
                    </div>
                </div>
                <!-- Mostrar cálculo total -->
                <div class="mt-2 text-muted small text-center" t-if="boxes and unitsPerBox">
                    <i class="fa fa-calculator me-1"/>
                    Total calculado: <strong t-out="(boxes || 0) * (unitsPerBox || 1)"/> unidades
                </div>

                <!-- Controles de cantidad en línea -->
                <div class="input-group input-group-sm mt-2">
                    <button class="btn btn-primary border"
                            t-on-click.stop="this.env.decreaseQuantity"
                            t-att-disabled="disableRemove"
                            t-att-data-tooltip="disabledButtonTooltip">
                        <i class="fa fa-minus center"/>
                    </button>
                    <input class="o_input form-control border text-center text-bg-light"
                            type="number"
                            t-att-value="quantity"
                            t-on-change="this.env.setQuantity"
                            t-on-focus="_onFocus"
                    />
                    <button class="btn btn-primary border"
                            t-on-click.stop="(ev) => this.env.increaseQuantity()">
                        <i class="fa fa-plus"/>
                    </button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
